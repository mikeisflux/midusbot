# ── Wallet ──────────────────────────────────────────────────────────────────
# Your Polygon wallet private key (no 0x prefix).
# This wallet must hold USDC on Polygon to place real orders.
PRIVATE_KEY=your_private_key_here

# ── Polymarket CLOB API credentials ─────────────────────────────────────────
# Leave blank to auto-derive from PRIVATE_KEY on first run.
# After first run, copy the printed values here to skip re-derivation.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ── Network ──────────────────────────────────────────────────────────────────
# 137  = Polygon mainnet (real money)
# 80002 = Amoy testnet   (no real money)
CHAIN_ID=137

# ── Safety ───────────────────────────────────────────────────────────────────
# DRY_RUN=true  → analyse markets and log signals but never submit orders
# DRY_RUN=false → live trading (real USDC)
DRY_RUN=true

# ── Position sizing ──────────────────────────────────────────────────────────
MAX_POSITION_USDC=10        # Maximum USDC per single position
MAX_TOTAL_EXPOSURE_USDC=100 # Maximum total USDC at risk across all positions
KELLY_FRACTION=0.25         # Fraction of full Kelly to use (0.25 = quarter-Kelly)

# ── Strategy thresholds ──────────────────────────────────────────────────────
MIN_EDGE=0.03               # Minimum required edge before trading (3 %)
MIN_LIQUIDITY_USDC=1000     # Skip markets with less liquidity than this
MIN_VOLUME_24H_USDC=100     # Skip markets with less 24-h volume than this

# ── Bot loop ─────────────────────────────────────────────────────────────────
LOOP_INTERVAL_SECONDS=60    # Seconds between market scans
